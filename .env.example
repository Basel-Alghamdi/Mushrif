# Copy to .env at the repo root for local development. On Railway, set these per service instead.
# Never commit real values.

# ─── Web (apps/web) — NEXT_PUBLIC_* values are inlined at build time ───
# Leave empty to call the API through the web app (/api/v1 is forwarded to API_PROXY_TARGET) — works from phones too.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Runtime (Railway sets PORT automatically) ───
PORT=4000
# Public address of the web app (used in login/reminder messages the assistant prepares)
APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API directly; defaults to APP_URL
CORS_ORIGINS=http://localhost:3000
TZ=Asia/Riyadh

# ─── Database (Supabase Postgres) ───
# Running API: Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# Migrations: Supabase → Connect → Direct connection (port 5432). Falls back to DATABASE_URL when empty.
DIRECT_DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
# Connections per API instance (default 10)
DATABASE_POOL_SIZE=10

# ─── Supabase (Auth, Storage, admin API) ───
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server only — never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Only for projects still signing tokens with the legacy JWT secret; leave empty to verify with the project's JWKS.
SUPABASE_JWT_SECRET=
# Private Storage bucket for uploaded files (created automatically if missing)
SUPABASE_STORAGE_BUCKET=attachments

# ─── Email (Resend): invitations, reminders, password reset ───
RESEND_API_KEY=
RESEND_FROM=Rasd <noreply@your-verified-domain.sa>

# ─── AI assistant (head's chat) ───
# Works without any key (built-in Arabic engine). With a Claude key it understands free-form questions and reads scanned files.
ANTHROPIC_API_KEY=
# Claude Sonnet 5.5 by default. claude-haiku-4-5 is cheaper (it ignores ANTHROPIC_EFFORT: Haiku has no effort setting).
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
# OpenAI is used only when ANTHROPIC_API_KEY is empty. The API reads the repo-root .env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5
# Reserved for future extraction/embedding integrations.
OPENAI_EXTRACT_MODEL=
OPENAI_EMBED_MODEL=

# ─── First head account: pnpm --filter @rasd/api bootstrap:head ───
RASD_ADMIN_EMAIL=khulood@example.com
RASD_ADMIN_NAME=خلود
# Required, at least 8 characters. The head always gets her password here (her account is never claimable at first sign-in).
RASD_ADMIN_PASSWORD=
RASD_DISTRICT_NAME=النطاق الإشرافي

# ─── Team roster (personal data — never commit it): pnpm --filter @rasd/api seed:roster ───
# Default: apps/api/data/roster.xlsx (the sign-up form export: الاسم · الصفة · البريد)
RASD_ROSTER_FILE=
