# Copy to .env at the repo root for local development. On Railway, set these per service instead.
# Never commit real values.

# ─── Web (apps/web) — NEXT_PUBLIC_* values are inlined at build time ───
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Runtime (Railway sets PORT automatically) ───
PORT=4000
APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API; defaults to APP_URL
CORS_ORIGINS=http://localhost:3000
TZ=Asia/Riyadh

# ─── Database (Supabase Postgres) ───
# Running API: Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# Migrations: Supabase → Connect → Direct connection (port 5432). Falls back to DATABASE_URL when empty.
DIRECT_DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
# Connections per API instance (default 10)
DATABASE_POOL_SIZE=10

# ─── Supabase (Auth, admin API) ───
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server only — never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Only for projects still signing tokens with the legacy JWT secret; leave empty to verify with the project's JWKS.
SUPABASE_JWT_SECRET=

# ─── Email (Resend): invitations, reminders, password reset ───
RESEND_API_KEY=
RESEND_FROM=Rasd <noreply@your-verified-domain.sa>

# ─── AI (OpenAI): assistant and smart import — reserved for the OpenAI phase, not read by the code yet ───
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EXTRACT_MODEL=
OPENAI_EMBED_MODEL=

# ─── First head account: pnpm --filter @rasd/api bootstrap:head ───
RASD_ADMIN_EMAIL=s.alqahtani@moe.gov.sa
RASD_ADMIN_NAME=سارة القحطاني
# At least 12 characters; used only when the account is first created
RASD_ADMIN_PASSWORD=
RASD_DISTRICT_NAME=النطاق الإشرافي
