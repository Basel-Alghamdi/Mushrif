# ---------- Web (apps/web/.env.local) ----------
# The browser calls /api/v1 on the web app itself; Next.js forwards it here.
API_PROXY_TARGET=http://localhost:4000

# ---------- API (apps/api/.env) ----------
PORT=4000
TZ=Asia/Riyadh
# Address used inside login messages the assistant prepares for members (use your LAN/public address for phones)
APP_URL=http://localhost:3000

# Local persistence
RASD_DATABASE_FILE=./data/rasd.sqlite
# Team roster (personal data — never commit it). Default: apps/api/data/roster.xlsx
RASD_ROSTER_FILE=

# District head (خلود). She signs in with this email; the first time she chooses her password.
RASD_ADMIN_EMAIL=khulood@rasd.local
RASD_ADMIN_NAME=خلود
# Optional: preset her password instead of choosing it at first login
RASD_ADMIN_PASSWORD=

# Claude — optional. Without a key the assistant uses its built-in Arabic engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ---------- Planned integrations (not used by the code yet) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DIRECT_DATABASE_URL=
PII_ENCRYPTION_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM=Rasd <noreply@example.com>
